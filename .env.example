# =============================================================================
# Copy this file to .env and fill in real values before running docker-compose.
# =============================================================================

# ---- JWT (shared secret between API Gateway and User Service) -------------
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=1h

# ---- Postgres: User Service -------------------------------------------------
USER_DB_HOST=user-postgres
USER_DB_PORT=5432
USER_DB_NAME=user_service
USER_DB_USER=user_service_app
USER_DB_PASSWORD=replace_with_strong_password

# ---- Postgres: Notification Service -----------------------------------------
NOTIF_DB_HOST=notification-postgres
NOTIF_DB_PORT=5432
NOTIF_DB_NAME=notification_service
NOTIF_DB_USER=notification_service_app
NOTIF_DB_PASSWORD=replace_with_strong_password

# ---- NATS (message broker) --------------------------------------------------
# Internal cluster address services use to connect
NATS_URL=tls://nats:4222

NATS_USER=svc_user
NATS_PASSWORD=replace_with_strong_password

NATS_TLS_ENABLED=true
NATS_CA_CERT_PATH=/etc/nats/certs/ca.pem
NATS_STREAM_NAME=USER_EVENTS
NATS_SUBJECT_PREFIX=user

# ---- Service ports -----------------------------------------------------------
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=4001
NOTIFICATION_SERVICE_PORT=4002

USER_SERVICE_URL=http://user-service:4001
NOTIFICATION_SERVICE_URL=http://notification-service:4002

# ---- Rate limiting (API Gateway) --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

NODE_ENV=development
LOG_LEVEL=info
